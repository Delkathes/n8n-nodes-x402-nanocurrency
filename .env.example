# Copy this file to .env if you need local environment variables.
# Never commit the real .env file.

# GitHub fine-grained token, used by release tooling to create releases.
# Prefer `gh auth login` instead of storing tokens on disk.
FINE_GRAINED_GITHUB_TOKEN=

# Local x402 facilitator (used by tests and manual runs).
# FACILITATOR_URL=http://localhost:5555/facilitator
